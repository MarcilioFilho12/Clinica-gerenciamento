# VITE — variáveis do front Marag
# Copie para `.env` / `.env.local` (dev) ou defina no painel do host no build.

# URL da API incluindo /api (obrigatório em build de produção/staging)
VITE_API_URL=http://localhost:8000/api

# Slug padrão opcional (login ainda pede clínica)
# VITE_CLINIC_SLUG=demo

# Reverb / telão (opcional — piloto pode ficar off)
# VITE_REVERB_APP_KEY=
# VITE_REVERB_HOST=
# VITE_REVERB_PORT=8080
# VITE_REVERB_SCHEME=http

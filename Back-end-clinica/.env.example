APP_NAME=Marag
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Database tenant default (trocado em runtime por clínica) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=marag_clinic_demo
DB_USERNAME=root
DB_PASSWORD=

# --- Banco central (clínicas / branding) ---
CENTRAL_DB_HOST=127.0.0.1
CENTRAL_DB_PORT=3306
CENTRAL_DB_DATABASE=marag_central
CENTRAL_DB_USERNAME=root
CENTRAL_DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

# JWT (PRG 1.x)
JWT_KEY=change-me-in-production
JWT_TTL_SECONDS=7200

# Apenas local/testing — IGNORADO em APP_ENV=production
# DEFAULT_CLINIC_SLUG=demo

# Front origins separados por vírgula (staging/prod). Local pode usar *
CORS_ALLOWED_ORIGINS=*
# Ex. produção: CORS_ALLOWED_ORIGINS=https://app.seudominio.com,https://xxx.vercel.app

# --- Exemplo Railway / produção (colar no painel; APP_DEBUG=false) ---
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://seu-servico.up.railway.app
# SESSION_DRIVER=file
# CACHE_STORE=file
# QUEUE_CONNECTION=sync
# BROADCAST_CONNECTION=log
# JWT_TTL_SECONDS=7200
# DB_HOST=${{MySQL.MYSQLHOST}}
# DB_PORT=${{MySQL.MYSQLPORT}}
# DB_DATABASE=marag_clinic_piloto
# DB_USERNAME=${{MySQL.MYSQLUSER}}
# DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}
# CENTRAL_DB_HOST=${{MySQL.MYSQLHOST}}
# CENTRAL_DB_PORT=${{MySQL.MYSQLPORT}}
# CENTRAL_DB_DATABASE=marag_central
# CENTRAL_DB_USERNAME=${{MySQL.MYSQLUSER}}
# CENTRAL_DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}
# CORS_ALLOWED_ORIGINS=https://seu-front.vercel.app
# (NÃO definir DEFAULT_CLINIC_SLUG)
# Guia completo: docs/PASSO_A_PASSO_DEPLOY.md

# Reverb (telão) — opcional; piloto pode ficar off
# REVERB_APP_ID=
# REVERB_APP_KEY=
# REVERB_APP_SECRET=
# REVERB_HOST=
# REVERB_PORT=443
# REVERB_SCHEME=https
